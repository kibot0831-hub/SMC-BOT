# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── BingX (solo necesarias si AUTO_TRADE=true). Permisos: Lectura + Trading de Futuros. SIN retiros. ──
BINGX_API_KEY=
BINGX_API_SECRET=

# ── Modo ──
AUTO_TRADE=false          # true = opera de verdad
TIMEFRAME=5m

# ── Universo ──
MIN_VOLUME_USDT=1000000   # volumen 24h mínimo (0 = todas las monedas)
MAX_SYMBOLS=0             # 0 = sin límite (top por volumen si > 0)
INCLUDE_SYMBOLS=          # ej: BTC-USDT,ETH-USDT (vacío = todas)
EXCLUDE_SYMBOLS=
REQ_PER_SEC=8

# ── Estrategia (igual al Pine) ──
SWING_LEN=5
ENTRY_MODE=Retest OB      # Retest OB | Mitad del OB
OB_MITIGATION=Close through   # Close through | Wick through
COOLDOWN_BARS=8
SL_BUFFER_ATR=0.1
RR_TARGET=2.5
USE_LIQUIDITY_TP=true

# ── Filtros extra (opcionales) ──
MIN_RR=1.0
MAX_RISK_PCT=3.0          # descarta señales con SL más lejos de X% del precio
REQUIRE_SWEEP=false       # exigir barrida de liquidez previa al CHOCH/MSS
SWEEP_LOOKBACK=30
OB_MIN_AGE=0              # velas mínimas entre creación del OB y la entrada

# ── Riesgo / ejecución ──
RISK_PCT=1.0              # % del equity arriesgado por trade
FIXED_MARGIN_USDT=0       # >0 = margen fijo por trade (ignora RISK_PCT)
LEVERAGE=5
MAX_MARGIN_PCT=20         # tope de margen por trade (% equity)
MAX_POSITIONS=5
MARGIN_MODE=ISOLATED
